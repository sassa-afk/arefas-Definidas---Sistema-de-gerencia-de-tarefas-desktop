<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/p1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tarefasP1"
    android:orientation="vertical"
    android:background="@color/geral"
     tools:openDrawer="start"
     >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">



            <ImageView
                android:layout_marginTop="130dp"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/fotoPerfil"
                android:gravity="center" />
            <TextView
                android:id="@+id/eu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:gravity="center"
                android:textSize="15dp"
                android:textColor="@color/white"

                />


            <Button
                android:layout_marginTop="40dp"
                android:id="@+id/verTarefas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tarefas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/black"
                android:drawableLeft="@drawable/check"
                android:tooltipText="Acessar minhas tarefas "

                />



                <Button
                    android:tooltipText="Informações de meus indicadores de tarefas "
                     android:id="@+id/resultados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meus indicadores"
                    android:layout_marginTop="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/black"
                    android:drawableLeft="@drawable/resutado"
                    />
            <Button
                android:id="@+id/editarContato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Editar contato"
                android:tooltipText="Editar meu contato "

                android:layout_marginTop="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@android:color/white"
                android:backgroundTint= "@color/black"
                android:drawableLeft="@drawable/edte"

                />

            <Button
                android:id="@+id/trocarFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trocar foto"
                android:tooltipText="Trocar foto "

                android:layout_marginTop="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@android:color/white"
                android:backgroundTint= "@color/black"
                android:drawableLeft="@drawable/ft1"
                />
            <Button
                android:id="@+id/senha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trocar senha"
                android:tooltipText="Trocar minha senha "

                android:layout_marginTop="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="@android:color/white"
                android:backgroundTint= "@color/black"
                android:drawableLeft="@drawable/pw"
                />

        </LinearLayout>
    </ScrollView>


<!--    =============================-->

    <include layout="@layout/activy_main_content" />


    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:menu="@menu/drawer_item"
        app:headerLayout="@layout/header"
        android:layout_gravity="start"

        tools:ignore="MissingConstraints" />

<!--    =============================-->


</androidx.drawerlayout.widget.DrawerLayout>


